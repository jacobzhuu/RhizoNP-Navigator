# Copy this file to .env and fill only local, non-committed values.

# LLM
DEEPSEEK_API_KEY=
QWEN_API_KEY=
LLM_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0

# Retrieval models. Use model IDs or local paths that exist on the target machine.
EMBEDDING_MODEL=yangjhchs/acge_text_embedding
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VECTOR_DB_PATH=data/faiss_all_acge

# Phase 2 literature retrieval adapters (offline defaults for tests)
LITERATURE_EMBEDDING_PROVIDER=hashing
LITERATURE_HASHING_DIMENSIONS=128
LITERATURE_VECTOR_INDEX_BACKEND=in_memory
LITERATURE_RERANKER=lexical

# NCBI E-utilities (required for live PubMed fetch; tests use mocked HTTP)
NCBI_TOOL_NAME=RhizoNP-Navigator
NCBI_EMAIL=
NCBI_API_KEY=
NCBI_REQUEST_TIMEOUT=30
NCBI_MAX_RESULTS=20

# PostgreSQL. Prefer DATABASE_URL when available.
# If DATABASE_URL is empty, start.sh derives it from POSTGRES_* (password defaults to rhizonp_dev).
# Example when POSTGRES_USER=postgres in .env:
# DATABASE_URL=postgresql://postgres:rhizonp_dev@127.0.0.1:5432/postgres
# Pure compose defaults (no POSTGRES_* in .env):
# postgresql://rhizonp:rhizonp_dev@localhost:5432/rhizonp
DATABASE_URL=
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Runtime
RHIZONP_RUNTIME_MODE=dev
TOP_K_RERANK_DOCS=10
